# vLLM OpenAI-compatible model server.
# Default image from vLLM. Model is mounted from a GCS-backed PVC or local volume.
FROM vllm/vllm-openai:latest

ENV HF_HOME=/models
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn

# Serve an OpenAI-compatible endpoint on 8000
EXPOSE 8000

# Run interactively: serve --model <model> --port 8000
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]